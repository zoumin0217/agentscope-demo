# 以下 OpenAI 兼容接口配置为可选项；使用时请填写对应服务商提供的信息
# OpenAI API 密钥：可在 OpenAI 平台的 API keys 页面获取
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# API 接口地址：按服务商文档填写；使用 OpenAI 官方接口时通常可留空
OPENAI_BASE_URL=
# 模型名称：填写所选服务商支持的模型 ID
OPENAI_MODEL=

# 阿里云百炼 DashScope API 密钥：可在百炼控制台获取
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# Ollama 默认连接 localhost:11434；自定义连接地址或模型时填写
OLLAMA_HOST=
OLLAMA_MODEL=

# DeepSeek API 密钥：可在 DeepSeek 开放平台的 API Keys 页面获取
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
